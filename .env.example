# ══════════════════════════════════════════════════════════════════════
#  .env — Environment variables for the SDG Skill-Trees pipeline
# ══════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in values.
# None of the MVS datasets require API keys, but some extensions do.

# ── Optional: World Values Survey ────────────────────────────────────
# WVS requires accepting a license agreement. After downloading,
# place the file in data_raw/wvs/ — no API key needed.
# WVS_DOWNLOAD_TOKEN=

# ── Optional: IEA data ───────────────────────────────────────────────
# IEA World Energy Balances requires a paid subscription.
# IEA_API_KEY=

# ── Optional: OECD ───────────────────────────────────────────────────
# OECD.Stat API is free but may require a token for high volume.
# OECD_API_KEY=

# ── Pipeline settings ────────────────────────────────────────────────
# Override config.yaml values via env vars if needed.
# LOG_LEVEL=INFO
# MAX_RETRIES=3
# REQUEST_TIMEOUT=120
